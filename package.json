{
  "name": "demo-mutation",
  "version": "1.0.0",
  "description": "Demo: por que 100% de cobertura de testes não significa ausência de bugs — e como mutation testing revela vazamentos silenciosos em regras críticas.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "jest --coverage",
    "test:mutation": "stryker run",
    "report:summary": "node scripts/write-summary.js"
  },
  "jest": {
    "coverageReporters": ["text", "text-summary", "html", "json-summary"]
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "jest": "^30.4.2"
  }
}
